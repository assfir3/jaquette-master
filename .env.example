# Copie ce fichier en .env.local et colle ta clé (https://www.steamgriddb.com/profile/preferences/api).
# Optionnelle : sans elle, la recherche utilise seulement Steam.
STEAMGRIDDB_API_KEY=

# Optionnelle : clé MobyGames (profil MobyGames → API) pour les jaquettes officielles scannées,
# classées par pays (France…). Usage personnel ; l'usage commercial demande leur accord.
MOBYGAMES_API_KEY=
